{
  "name": "yugioh-custom-duel",
  "version": "1.0.0",
  "description": "Installable Yu-Gi-Oh! custom duel game",
  "main": "service-worker.js",
  "scripts": {
    "cap:init": "cap init \"Yu-Gi-Oh! Custom Duel\" com.spaceturismo.customduel --web-dir .",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "test": "node --check service-worker.js"
  },
