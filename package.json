{
  "name": "yugioh-custom-duel",
  "version": "1.0.0",
  "description": "Installable Yu-Gi-Oh! custom duel game",
  "main": "service-worker.js",
  "scripts": {
    "server:dev": "tsx server/src/server.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/server.js",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "cap:init": "cap init \"Yu-Gi-Oh! Custom Duel\" com.spaceturismo.customduel --web-dir .",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "test": "node --check service-worker.js && node --check client/duel-model.js && node --check client/card-catalog.js && node --check client/storage.js && node --check client/duel-state.js && node --check client/multiplayer.js && node --test --import tsx test/domain.test.ts test/duel-model.test.js test/server.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spaceturismo/Yugioh-Custom-duel.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/spaceturismo/Yugioh-Custom-duel/issues"
  },
  "homepage": "https://github.com/spaceturismo/Yugioh-Custom-duel#readme"
}
