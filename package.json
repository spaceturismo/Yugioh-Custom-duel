    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/spaceturismo/Yugioh-Custom-duel/issues"
